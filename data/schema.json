{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decode catalog: 15 suite apps plus launcher utility",
  "type": "array",
  "minItems": 14,
  "maxItems": 16,
  "items": {
    "type": "object",
    "required": [
      "slug",
      "name",
      "icon",
      "category",
      "kind",
      "tagline",
      "description",
      "platforms",
      "license",
      "licenseUrl",
      "websiteUrl",
      "sourceUrl",
      "downloadUrl",
      "tags",
      "stage",
      "featured"
    ],
    "properties": {
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "enum": [
          "photocraft",
          "vectorcraft",
          "filmcraft",
          "lightcraft",
          "pdfcraft",
          "effectcraft",
          "designcraft",
          "figcraft",
          "wordcraft",
          "soundcraft",
          "deckcraft",
          "cadcraft",
          "gridcraft",
          "decode-craft",
          "decode-craftx",
          "decode-launcher"
        ]
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Personalized Decode display name; the official project name is preserved as a search tag."
      },
      "icon": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "Imagem e fotografia",
          "Design e publicação",
          "Vídeo e motion",
          "Documentos e produtividade",
          "Áudio",
          "CAD e engenharia",
          "Launchers e utilitários"
        ]
      },
      "kind": {
        "enum": [
          "Aplicativo Decode",
          "Crafting App",
          "Launcher"
        ]
      },
      "tagline": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "platforms": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "license": {
        "const": "MIT OR Apache-2.0"
      },
      "licenseUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://github\\.com/Kaiqueaurelio/decode-open-source-hub/"
      },
      "websiteUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://(decode-open-source-hub\\.vercel\\.app|decode-open-source-hub-catalog\\.vercel\\.app|kaiqueaurelio\\.github\\.io)"
      },
      "sourceUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://github\\.com/Kaiqueaurelio/decode-open-source-hub/"
      },
      "downloadUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://github\\.com/Kaiqueaurelio/decode-open-source-hub/"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "stage": {
        "type": "string",
        "minLength": 1
      },
      "featured": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  }
}
